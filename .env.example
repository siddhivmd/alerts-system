# Copy to .env (same folder as config.yaml) and fill in. Never commit .env.

# SMTP password. For Gmail use an App Password (Google Account > Security > App passwords).
SMTP_PASSWORD=
# Optional: SMTP username, if you prefer not to put it in config.yaml
SMTP_USERNAME=

# Telegram bot token from @BotFather, e.g. 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=

# Password for the web dashboard (username is dashboard.username in config.yaml).
# The dashboard does not start without it.
DASHBOARD_PASSWORD=

# Passphrase for the SSH private key, if it has one.
SSH_KEY_PASSPHRASE=

# Watchdog ping URL from healthchecks.io (optional; also set heartbeat.enabled: true).
# Keep it secret: anyone with it can fake "the monitor is alive". Example: https://hc-ping.com/<uuid>
HEARTBEAT_URL=

# Test-account passwords for login checks (sites[].login.fields: "env:NAME"). Use a dedicated,
# low-privilege test account, never a real admin. Example:
# PORTAL_TEST_PASS=

# Google malware/phishing check (optional; also set security.safe_browsing: true).
# Default provider web_risk (commercial use): console.cloud.google.com > enable "Web Risk API" > Credentials.
GOOGLE_WEB_RISK_KEY=
# Only if security.safe_browsing_provider: safe_browsing (free API, non-commercial use only):
GOOGLE_SAFE_BROWSING_KEY=

# HTTPS front door (docker compose --profile https): the DNS name pointing at this server.
MONITOR_DOMAIN=
